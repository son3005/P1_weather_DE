        temperature_2m,
        relative_humidity_2m,
        precipitation,
        wind_speed_10m,
        weather_code,
        _ingested_at,
        _run_id,
        _source_url
    FROM ranked
    WHERE row_num = 1
)
SELECT * FROM deduped
  );

